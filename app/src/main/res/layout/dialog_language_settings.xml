<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:labelFor="@id/ui_language"
            android:text="@string/ui_language"
            android:textAppearance="?attr/textAppearanceSubtitle1" />

        <Spinner
            android:id="@+id/ui_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:spinnerMode="dialog"
            android:prompt="@string/ui_language" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:labelFor="@id/quiz_language"
            android:text="@string/quiz_language"
            android:textAppearance="?attr/textAppearanceSubtitle1" />

        <Spinner
            android:id="@+id/quiz_language"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="48dp"
            android:spinnerMode="dialog"
            android:prompt="@string/quiz_language" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:text="@string/language_settings_help"
            android:textAppearance="?attr/textAppearanceBody2" />
    </LinearLayout>
</ScrollView>
